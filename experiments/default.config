# Remon configuration file
# Copy this to build/remon.config before running experiments

# Maximum RAM available before swapping to remote memory (GB)
MAX_RAM_IN_GB: 4

# Maximum virtual memory size (GB)
MAX_VM_IN_GB: 64

# Memory node IP address (leave empty for local-only mode)
PEER: 

# Local swap disk path (created automatically)
SWAP_DISK: ./build/remon_swap

# Page size in bytes (default: 832KB)
PAGE_SIZE: 851968
